\item \code{device_sensors}: \code{device_id}, \code{position}, \code{sensor_type}, \code{datasheet_id},
and \code{datasheet_link_status}.
\item \code{datasheets}: \code{datasheet_id}, \code{schema_version}, \code{datasheet_version},
